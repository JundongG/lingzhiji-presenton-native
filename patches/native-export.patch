--- a/servers/nextjs/app/global-error.tsx
+++ b/servers/nextjs/app/global-error.tsx
@@ -1,25 +1,23 @@
 "use client";
 
-import NextError from "next/error";
+// Modified for the Lingzhiji fork, 2026-10-03: bilingual recovery without provider changes.
 import { useEffect } from "react";
+import { UiLanguageControl, useUiLocale, useUiText } from "@/lib/ui-i18n";
 
-export default function GlobalError({
-  error,
-}: {
-  error: Error & { digest?: string };
-}) {
-  useEffect(() => {
-    console.error("Global error:", error);
-  }, [error]);
-
+export default function GlobalError({ error, reset }: { error: Error & { digest?: string }; reset: () => void }) {
+  const locale = useUiLocale();
+  const t = useUiText();
+  useEffect(() => { console.error("Global error:", error); }, [error]);
   return (
-    <html lang="en">
-      <body>
-        {/* `NextError` is the default Next.js error page component. Its type
-        definition requires a `statusCode` prop. However, since the App Router
-        does not expose status codes for errors, we simply pass 0 to render a
-        generic error message. */}
-        <NextError statusCode={0} />
+    <html lang={locale}>
+      <body style={{ fontFamily: "system-ui, sans-serif", margin: 0 }}>
+        <main style={{ maxWidth: 520, margin: "15vh auto", padding: 24 }}>
+          <UiLanguageControl />
+          <h1>{t("Something went wrong")}</h1>
+          <p>{t("Please try again.")}</p>
+          <button onClick={reset}>{t("Try again")}</button>{" "}
+          <button onClick={() => window.location.reload()}>{t("Reload page")}</button>
+        </main>
       </body>
     </html>
   );
