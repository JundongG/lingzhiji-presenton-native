  "layouts": {
    "native_cover": {
      "components": [
        {
          "id": "native_cover_heading",
          "elements": [
            {
              "match": {
                "type": "text",
                "name": "headline"
              },
              "patch": {
                "min_length": 1,
                "max_length": 56,
                "font": {
                  "line_height": 1.15
